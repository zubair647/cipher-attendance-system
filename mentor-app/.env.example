# Copy this file to .env.local (local dev) and set the same values in Vercel.

# The Google Apps Script Web App URL (ends in /exec).
CIPHER_BACKEND_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Web push (VAPID) keys — generate with:  npx web-push generate-vapid-keys
# The PUBLIC key is exposed to the browser (NEXT_PUBLIC_ prefix); the PRIVATE key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_SUBJECT=mailto:admin@cipherschools.com

# Shared secret that protects the reminder trigger endpoint. Any long random string.
# Must match the CRON_SECRET repository secret used by the GitHub Actions scheduler.
CRON_SECRET=your_long_random_secret

# Copy this file to .env.local and fill in your values.

# The Google Apps Script Web App URL (ends in /exec).
CIPHER_BACKEND_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# The admin sign-in for the dashboard. Your backend has no admin accounts, so
# the admin login is handled here in the app. Change these before real use.
ADMIN_EMAIL=admin@cipherschools.com
ADMIN_PASSWORD=admin123
